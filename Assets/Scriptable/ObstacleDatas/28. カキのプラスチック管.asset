  m_EditorClassIdentifier: Assembly-CSharp::ObstacleData
  id: 28
  displayName: "\u990A\u6B96\u306E\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u7BA1"
  prefab: {fileID: 2575805199110171709, guid: a6313bc5b0ffd8d4d9d76462f2f36420, type: 3}
  baseSpeed: 7.5
  encyclopediaSprite: {fileID: -6307057659806694949, guid: 1a0fc78f44e69f64e8262714b589f0a0, type: 3}
  description: "\u30AB\u30AD\u306E\u990A\u6B96\u306A\u3069\u3067\u4F7F\u308F\u308C\u308B\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u88FD\u306E\u7BA1\u3002"
  decomposition: "\uFF08\u8ABF\u67FB\u4E2D\uFF09\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
  materials: "\u30DD\u30EA\u30A8\u30C1\u30EC\u30F3\uFF08PE\uFF09\n\u30DD\u30EA\u30D7\u30ED\u30D4\u30EC\u30F3\uFF08PP\uFF09\u306A\u3069"
  sources: "\u990A\u6B96\u65BD\u8A2D\u306E\u7834\u640D\n\u53F0\u98A8\u3084\u9AD8\u6CE2\n\u707D\u5BB3\n\u7D4C\u5E74\u52A3\u5316\u306A\u3069"
  trivia: "\u990A\u6B96\u306B\u4F7F\u308F\u308C\u308B\u8CC7\u6750\u306F\u4E08\u592B\u306A\u305F\u3081\u3001\u6D77\u306B\u6D41\u51FA\u3059\u308B\u3068\u9577\u3044\u9593\u6B8B\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\u305D\u306E\u305F\u3081\u3001\u3088\u308A\u74B0\u5883\u306B\u914D\u616E\u3057\u305F\u990A\u6B96\u8CC7\u6750\u3078\u306E\u53D6\u308A\u7D44\u307F\u304C\u9032\u3081\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
  era: "\u5E83\u304F\u4F7F\u308F\u308C\u59CB\u3081\u305F\u5E74\u4EE3\uFF1A\u8ABF\u67FB\u4E2D"
