  description: "\u767A\u6CE1\u30B9\u30C1\u30ED\u30FC\u30EB\u304C\u7D30\u304B\u304F\u7815\u3051\u305F\u3082\u306E\u3002\u6D77\u5CB8\u3067\u306F\u767D\u3044\u7C92\u3068\u306A\u3063\u3066\u898B\u3064\u304B\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002"
  decomposition: "\u6CE2\u3084\u7D2B\u5916\u7DDA\u3067\u3055\u3089\u306B\u7D30\u304B\u304F\u7815\u3051\u3066\u3044\u304D\u307E\u3059\u3002\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
  materials: "\u767A\u6CE1\u30B9\u30C1\u30ED\u30FC\u30EB\uFF08PS\uFF09"
  sources: "\u767A\u6CE1\u30B9\u30C1\u30ED\u30FC\u30EB\u88FD\u54C1\u306E\u7834\u7247\n\uFF08\u98DF\u54C1\u30C8\u30EC\u30FC\u30FB\u68B1\u5305\u6750\u30FB\u6F01\u696D\u7528\u306E\u6D6E\u304D\u306A\u3069\uFF09"
  trivia: "\u7802\u6D5C\u306E\u767D\u3044\u7C92\u306E\u4E2D\u306B\u306F\u3001\u767A\u6CE1\u30B9\u30C1\u30ED\u30FC\u30EB\u304C\u6DF7\u3056\u3063\u3066\u3044\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002"
  era: "\u6D77\u306E\u3054\u307F\u554F\u984C\u3068\u3057\u3066\u6CE8\u76EE\u3055\u308C\u305F\u5E74\u4EE3\uFF1A2000\u5E74\u4EE3\u3054\u308D"
