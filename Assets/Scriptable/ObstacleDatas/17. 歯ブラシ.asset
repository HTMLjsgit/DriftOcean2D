  description: "\u6B6F\u30D6\u30E9\u30B7\u3084\u30AB\u30DF\u30BD\u30EA\u306A\u3069\u3001\u66AE\u3089\u3057\u306E\u4E2D\u3067\u4F7F\u308F\u308C\u308B\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u88FD\u54C1\u3002\u53E4\u304F\u306A\u308B\u3068\u4EA4\u63DB\u3055\u308C\u307E\u3059\u3002"
  decomposition: "\u4E00\u822C\u7684\u306A\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u88FD\u54C1\uFF1A\u7D04400\uFF5E500\u5E74\uFF08\u76EE\u5B89\uFF09"
  materials: "\u30DD\u30EA\u30D7\u30ED\u30D4\u30EC\u30F3\uFF08PP\uFF09\n\u30DD\u30EA\u30A8\u30C1\u30EC\u30F3\u30C6\u30EC\u30D5\u30BF\u30EC\u30FC\u30C8\uFF08PET\uFF09\nABS\u6A39\u8102\uFF08ABS\uFF09\u306A\u3069"
  sources: "\u5BB6\u5EAD\u3054\u307F\n\u6CB3\u5DDD\n\u707D\u5BB3\u306A\u3069"
  trivia: "\u8EAB\u8FD1\u306A\u65E5\u7528\u54C1\u306B\u306F\u3001\u3055\u307E\u3056\u307E\u306A\u7A2E\u985E\u306E\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u304C\u4F7F\u308F\u308C\u3066\u3044\u307E\u3059\u3002"
  era: "\u5E83\u304F\u4F7F\u308F\u308C\u59CB\u3081\u305F\u5E74\u4EE3\uFF1A1950\uFF5E1960\u5E74\u4EE3\u3054\u308D"
