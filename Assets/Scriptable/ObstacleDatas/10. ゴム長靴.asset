  encyclopediaSprite: {fileID: 7767382652269099633, guid: 48113f9e5d2f68d40938f6d58b9055f2, type: 3}
  description: "\u8DB3\u3092\u6C34\u3084\u6CE5\u304B\u3089\u5B88\u308B\u305F\u3081\u306E\u5C65\u304D\u7269\u3002\u30B4\u30E0\u88FD\u3068\u547C\u3070\u308C\u308B\u3053\u3068\u304C\u591A\u3044\u3067\u3059\u304C\u3001\u73FE\u5728\u306F\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u3084\u5408\u6210\u30B4\u30E0\u88FD\u3082\u591A\u304F\u4F7F\u308F\u308C\u3066\u3044\u307E\u3059\u3002"
  decomposition: "\u5929\u7136\u30B4\u30E0\uFF1A\u81EA\u7136\u7531\u6765\u306E\u305F\u3081\u3001\u74B0\u5883\u4E2D\u3067\u5F90\u3005\u306B\u5206\u89E3\u3055\u308C\u307E\u3059\u3002\n\u5408\u6210\u30B4\u30E0\uFF1A\uFF08\u8ABF\u67FB\u4E2D\uFF09\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
  materials: "\u5929\u7136\u30B4\u30E0\uFF08\u81EA\u7136\u7D20\u6750\uFF09\n\u5408\u6210\u30B4\u30E0\n\u30DD\u30EA\u5869\u5316\u30D3\u30CB\u30EB\uFF08PVC\uFF09\u306A\u3069"
  sources: "\u6F01\u696D\n\u8FB2\u696D\n\u6CB3\u5DDD\n\u707D\u5BB3\u306A\u3069"
  trivia: "\u30B4\u30E0\u306F\u9774\u3060\u3051\u3067\u306A\u304F\u3001\u30BF\u30A4\u30E4\u3084\u624B\u888B\u306A\u3069\u8EAB\u8FD1\u306A\u88FD\u54C1\u306B\u3082\u4F7F\u308F\u308C\u3066\u3044\u307E\u3059\u3002"
  era: "\u5E83\u304F\u4F7F\u308F\u308C\u59CB\u3081\u305F\u5E74\u4EE3\uFF1A1950\uFF5E1960\u5E74\u4EE3\u3054\u308D\uFF08PVC\u88FD\uFF09"
