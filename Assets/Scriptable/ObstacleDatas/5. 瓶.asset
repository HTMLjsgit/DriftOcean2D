  description: "\u98F2\u307F\u7269\u3084\u8ABF\u5473\u6599\u306A\u3069\u306B\u4F7F\u308F\u308C\u308B\u30AC\u30E9\u30B9\u88FD\u306E\u5BB9\u5668\u3002\u5272\u308C\u305F\u308A\u6CE2\u3067\u524A\u3089\u308C\u305F\u308A\u3057\u307E\u3059\u304C\u3001\u7D20\u6750\u305D\u306E\u3082\u306E\u306F\u81EA\u7136\u306B\u306F\u5206\u89E3\u3055\u308C\u307E\u305B\u3093\u3002"
  decomposition: "\uFF08\u8ABF\u67FB\u4E2D\uFF09\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
