  sources: "\u5BB6\u5EAD\u3054\u307F\n\u6CB3\u5DDD\n\u8239\u8236\n\u707D\u5BB3\u306A\u3069"
  trivia: "\u9577\u3044\u5E74\u6708\u3092\u304B\u3051\u3066\u6CE2\u3084\u7802\u306B\u78E8\u304B\u308C\u305F\u30AC\u30E9\u30B9\u306F\u300C\u30B7\u30FC\u30B0\u30E9\u30B9\u300D\u3068\u547C\u3070\u308C\u307E\u3059\u3002"
  era: "\u5E83\u304F\u4F7F\u308F\u308C\u59CB\u3081\u305F\u5E74\u4EE3\uFF1A\u7D00\u5143\u524D1\u4E16\u7D00\u3054\u308D"
