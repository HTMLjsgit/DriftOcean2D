  trivia: "\u5546\u54C1\u3092\u6C5A\u308C\u3084\u6E7F\u6C17\u304B\u3089\u5B88\u308B\u305F\u3081\u306B\u4F7F\u308F\u308C\u3066\u3044\u307E\u3059\u3002"
