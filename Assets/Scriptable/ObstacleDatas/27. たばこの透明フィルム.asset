  description: "\u305F\u3070\u3053\u3084\u304A\u83D3\u5B50\u3001\u5316\u7CA7\u54C1\u306A\u3069\u3001\u3055\u307E\u3056\u307E\u306A\u88FD\u54C1\u306E\u5305\u88C5\u306B\u4F7F\u308F\u308C\u308B\u900F\u660E\u306A\u30D5\u30A3\u30EB\u30E0\u3002"
  decomposition: "\uFF08\u8ABF\u67FB\u4E2D\uFF09\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
