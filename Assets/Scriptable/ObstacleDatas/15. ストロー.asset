  description: "\u4F7F\u3044\u6368\u3066\u306E\u30B9\u30D7\u30FC\u30F3\u3084\u30D5\u30A9\u30FC\u30AF\u3001\u30B9\u30C8\u30ED\u30FC\u306A\u3069\u3002\u8EFD\u3044\u305F\u3081\u3001\u81EA\u7136\u3078\u6D41\u51FA\u3057\u3084\u3059\u304F\u306A\u308A\u307E\u3059\u3002"
  decomposition: "PP\u306E\u5834\u5408\uFF1A\u7D04400\uFF5E500\u5E74\uFF08\u76EE\u5B89\uFF09\nPS\u306E\u5834\u5408\uFF1A\u7D04400\uFF5E500\u5E74\uFF08\u76EE\u5B89\uFF09\nPLA\u306E\u5834\u5408\uFF1A\u8ABF\u67FB\u4E2D"
  materials: "\u30DD\u30EA\u30D7\u30ED\u30D4\u30EC\u30F3\uFF08PP\uFF09\n\u30DD\u30EA\u30B9\u30C1\u30EC\u30F3\uFF08PS\uFF09\n\u30DD\u30EA\u4E73\u9178\uFF08PLA\uFF09\u306A\u3069"
  sources: "\u5BB6\u5EAD\u3054\u307F\n\u30EC\u30B8\u30E3\u30FC\n\u6CB3\u5DDD\n\u6D77\u5CB8\u306A\u3069"
  trivia: "\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u88FD\u3060\u3051\u3067\u306A\u304F\u3001\u6728\u3084\u7D19\u306A\u3069\u3055\u307E\u3056\u307E\u306A\u7D20\u6750\u306E\u3082\u306E\u3082\u3042\u308A\u307E\u3059\u3002"
  era: "\u6D77\u306E\u3054\u307F\u554F\u984C\u3068\u3057\u3066\u6CE8\u76EE\u3055\u308C\u305F\u5E74\u4EE3\uFF1A2010\u5E74\u4EE3\u3054\u308D"
