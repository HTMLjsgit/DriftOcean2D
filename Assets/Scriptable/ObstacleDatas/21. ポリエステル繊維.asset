  description: "\u8863\u985E\u306A\u3069\u306B\u4F7F\u308F\u308C\u308B\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u7E4A\u7DAD\u3002\u6D17\u6FEF\u306A\u3069\u3067\u6D41\u308C\u51FA\u305F\u7D30\u3044\u7E4A\u7DAD\u306F\u3001\u30DE\u30A4\u30AF\u30ED\u30D7\u30E9\u30B9\u30C1\u30C3\u30AF\u3068\u547C\u3070\u308C\u307E\u3059\u3002"
  decomposition: "\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
