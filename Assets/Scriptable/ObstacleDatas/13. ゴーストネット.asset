  description: "\u6D77\u306B\u6D41\u51FA\u3057\u305F\u6F01\u7DB2\u3002\u6D77\u306E\u4E2D\u3067\u9B5A\u3084\u30AB\u30E1\u3001\u6D77\u9CE5\u306A\u3069\u3092\u7D61\u3081\u53D6\u308A\u7D9A\u3051\u3066\u3057\u307E\u3044\u307E\u3059\u3002"
  decomposition: "\u30CA\u30A4\u30ED\u30F3\u88FD\uFF1A\u7D04600\u5E74\uFF08\u76EE\u5B89\uFF09"
  materials: "\u30CA\u30A4\u30ED\u30F3\uFF08PA\uFF09\n\u30DD\u30EA\u30A8\u30C1\u30EC\u30F3\uFF08PE\uFF09\n\u30DD\u30EA\u30D7\u30ED\u30D4\u30EC\u30F3\uFF08PP\uFF09\u306A\u3069"
  sources: "\u7D1B\u5931\n\u53F0\u98A8\u3084\u9AD8\u6CE2\n\u653E\u68C4\n\u6F01\u696D\u6D3B\u52D5\u306A\u3069"
  trivia: "\u300C\u30B4\u30FC\u30B9\u30C8\u30CD\u30C3\u30C8\uFF08\u5E7D\u970A\u7DB2\uFF09\u300D\u3068\u306F\u3001\u6301\u3061\u4E3B\u304C\u3044\u306A\u304F\u306A\u3063\u3066\u3082\u6D77\u3092\u6F02\u3044\u3001\u6F01\u3092\u7D9A\u3051\u3066\u3057\u307E\u3046\u7DB2\u306E\u3053\u3068\u3067\u3059\u3002"
  era: "\u6D77\u306E\u3054\u307F\u554F\u984C\u3068\u3057\u3066\u6CE8\u76EE\u3055\u308C\u305F\u5E74\u4EE3\uFF1A1980\u5E74\u4EE3\u5F8C\u534A\u3054\u308D"
