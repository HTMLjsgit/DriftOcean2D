  description: "\u7551\u306E\u571F\u3092\u8986\u3046\u305F\u3081\u306B\u4F7F\u308F\u308C\u308B\u9ED2\u3044\u30B7\u30FC\u30C8\u3002\u96D1\u8349\u3092\u6291\u3048\u305F\u308A\u571F\u306E\u6E29\u5EA6\u3084\u6C34\u5206\u3092\u4FDD\u3063\u305F\u308A\u3059\u308B\u305F\u3081\u306B\u4F7F\u308F\u308C\u307E\u3059\u3002"
  decomposition: "\uFF08\u8ABF\u67FB\u4E2D\uFF09\u74B0\u5883\u4E2D\u3067\u306F\u9577\u671F\u9593\u6B8B\u308B\u3053\u3068\u304C\u77E5\u3089\u308C\u3066\u3044\u307E\u3059\u3002"
